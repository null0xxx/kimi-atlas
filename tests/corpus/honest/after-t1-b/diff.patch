--- a/slugify.py
+++ b/slugify.py
@@ -4,3 +4,8 @@
 def normalize(text: str) -> str:
     """Collapse whitespace and lowercase."""
     return " ".join(text.split()).lower()
+
+
+def slugify(text: str) -> str:
+    """Lowercase ``text`` and join its words with single hyphens."""
+    return normalize(text).replace(" ", "-")
