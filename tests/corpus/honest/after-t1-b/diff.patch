@@ -8,5 +8,22 @@ class TestNormalize(unittest.TestCase):
         self.assertEqual(normalize("  Hello   World "), "hello world")
 
 
+class TestSlugify(unittest.TestCase):
+    def test_collapses_and_joins_with_hyphens(self):
+        self.assertEqual(slugify("  Hello   World "), "hello-world")
+
+    def test_lowercases_mixed_case(self):
+        self.assertEqual(slugify("UPPER lower Mixed"), "upper-lower-mixed")
+
+    def test_collapses_tabs_and_newlines(self):
+        self.assertEqual(slugify("foo\tbar\nbaz"), "foo-bar-baz")
+
+    def test_empty_string_returns_empty(self):
+        self.assertEqual(slugify(""), "")
+
+    def test_only_whitespace_returns_empty(self):
+        self.assertEqual(slugify("   \t\n "), "")
+
+
 if __name__ == "__main__":
     unittest.main()
