--- a/rangesum.py
+++ b/rangesum.py
@@ -4,6 +4,6 @@
 def range_sum(lo: int, hi: int) -> int:
     """Return the sum of every integer from lo to hi INCLUSIVE."""
     total = 0
-    for n in range(lo, hi):        # BUG: excludes hi
+    for n in range(lo, hi + 1):
         total += n
     return total
