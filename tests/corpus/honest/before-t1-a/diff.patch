+class TestSlugify(unittest.TestCase):
+    def test_joins_words_with_single_hyphen(self):
+        self.assertEqual(slugify("Hello   World Again"), "hello-world-again")
+
+    def test_strips_and_collapses_whitespace(self):
+        self.assertEqual(slugify("  Leading\tand\nTrailing  "), "leading-and-trailing")
+
+    def test_empty_string_returns_empty_slug(self):
+        self.assertEqual(slugify(""), "")
+
+    def test_whitespace_only_returns_empty_slug(self):
+        self.assertEqual(slugify("   \t\n "), "")
+
+
 if __name__ == "__main__":
     unittest.main()
