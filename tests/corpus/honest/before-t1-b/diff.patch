@@ -8,5 +8,22 @@ class TestNormalize(unittest.TestCase):
         self.assertEqual(normalize("  Hello   World "), "hello world")
 
 
+class TestSlugify(unittest.TestCase):
+    def test_lowercases_and_joins_with_hyphens(self):
+        self.assertEqual(slugify("Hello World Foo"), "hello-world-foo")
+
+    def test_collapses_whitespace_runs(self):
+        self.assertEqual(slugify("  Hello \t World \n "), "hello-world")
+
+    def test_single_word_has_no_hyphen(self):
+        self.assertEqual(slugify("Solo"), "solo")
+
+    def test_empty_string(self):
+        self.assertEqual(slugify(""), "")
+
+    def test_whitespace_only(self):
+        self.assertEqual(slugify("   \t\n  "), "")
+
+
 if __name__ == "__main__":
     unittest.main()
