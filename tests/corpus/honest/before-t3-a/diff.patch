diff --git a/parseport.py b/parseport.py
index 18af19e..35371f0 100644
--- a/parseport.py
+++ b/parseport.py
@@ -2,5 +2,15 @@
 
 
 def parse_port(text: str) -> int:
-    """Return the port as an int."""
-    return int(text)
+    """Return the port as an int.
+
+    Raises ValueError if the text is not numeric or the value is
+    outside the valid TCP port range 1-65535.
+    """
+    try:
+        port = int(text)
+    except (TypeError, ValueError):
+        raise ValueError(f"invalid port: {text!r}") from None
+    if not 1 <= port <= 65535:
+        raise ValueError(f"port out of range 1-65535: {text!r}")
+    return port
diff --git a/test_parseport.py b/test_parseport.py
index 4800ac7..dfd58d8 100644
--- a/test_parseport.py
+++ b/test_parseport.py
@@ -7,6 +7,51 @@ class TestParsePort(unittest.TestCase):
     def test_parses_a_normal_port(self):
         self.assertEqual(parse_port("8080"), 8080)
 
+    def test_returns_int_for_valid_input(self):
+        self.assertIsInstance(parse_port("8080"), int)
+
+    def test_accepts_low_boundary(self):
+        self.assertEqual(parse_port("1"), 1)
+
+    def test_accepts_high_boundary(self):
+        self.assertEqual(parse_port("65535"), 65535)
+
+    def test_rejects_non_numeric_input(self):
+        with self.assertRaises(ValueError):
+            parse_port("abc")
+
+    def test_rejects_partially_numeric_input(self):
+        with self.assertRaises(ValueError):
+            parse_port("80a0")
+
+    def test_rejects_empty_input(self):
+        with self.assertRaises(ValueError):
+            parse_port("")
+
+    def test_rejects_none_input(self):
+        with self.assertRaises(ValueError):
+            parse_port(None)
+
+    def test_rejects_non_string_input(self):
+        with self.assertRaises(ValueError):
+            parse_port([8080])
+
+    def test_rejects_zero(self):
+        with self.assertRaises(ValueError):
+            parse_port("0")
+
+    def test_rejects_negative_port(self):
+        with self.assertRaises(ValueError):
+            parse_port("-1")
+
+    def test_rejects_port_above_max(self):
+        with self.assertRaises(ValueError):
+            parse_port("65536")
+
+    def test_rejects_very_large_port(self):
+        with self.assertRaises(ValueError):
+            parse_port("999999")
+
 
 if __name__ == "__main__":
     unittest.main()
